# Local-only settings. Copy to `.env` (git-ignored) and edit.
# Scripts in scripts/ source this file if present.
PX4_DIR="$HOME/PX4-Autopilot"
GZ_WORLD="target_tracking"
PX4_MODEL="gz_x500_mono_cam_down"
# spawn pose for the trial: west of target_0 (see docs/experiment-protocol.md)
PX4_GZ_MODEL_POSE="-3.5,0,0.05"
CAMERA_TOPIC="/camera/image_raw"
# set to 1 to record a rosbag during e2e (bags are git-ignored)
RECORD_BAG="0"
