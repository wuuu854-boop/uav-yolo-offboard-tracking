@@ -419,6 +428,31 @@ void GZBridge::barometerCallback(const gz::msgs::FluidPressure &air_pressure)
 	pthread_mutex_unlock(&_node_mutex);
 }
 
+void GZBridge::magnetometerCallback(const gz::msgs::Magnetometer &magnetometer)
+{
+	if (hrt_absolute_time() == 0) {
+		return;
+	}
+
+	pthread_mutex_lock(&_node_mutex);
+
+	const uint64_t time_us = (magnetometer.header().stamp().sec() * 1000000)
+				 + (magnetometer.header().stamp().nsec() / 1000);
+
+	// Gazebo reports tesla; PX4 wants gauss in the FRD body frame.
+	sensor_mag_s sensor_mag{};
+	sensor_mag.timestamp_sample = time_us;
+	sensor_mag.device_id = 197388; // matches CAL_MAG0_ID set by init.d-posix/rcS
+	sensor_mag.x = static_cast<float>(magnetometer.field_tesla().x());
+	sensor_mag.y = static_cast<float>(magnetometer.field_tesla().y());
+	sensor_mag.z = static_cast<float>(magnetometer.field_tesla().z());
+	sensor_mag.temperature = 25.0f;
+	sensor_mag.timestamp = hrt_absolute_time();
+	_sensor_mag_pub.publish(sensor_mag);
+
+	pthread_mutex_unlock(&_node_mutex);
+}
